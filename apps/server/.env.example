# Optional: additional exact frontend origins, separated by commas. No wildcard.
# FRAMEOUT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional built Vite directory; defaults to ../frontend/dist.
# FRAMEOUT_FRONTEND_DIST=/absolute/path/to/frontend/dist
# Optional listen address for server/index.cjs (default 127.0.0.1:8000).
# HOST=127.0.0.1
# PORT=8000
