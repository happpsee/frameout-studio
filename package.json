{
  "name": "frameout",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:web": "pnpm --filter @frameout/web dev",
    "dev:server": "pnpm --filter @frameout/server dev",
    "desktop": "turbo run build --filter=@frameout/desktop && pnpm --filter @frameout/desktop start",
    "build:desktop": "turbo run build --filter=@frameout/desktop && pnpm --filter @frameout/desktop package",
    "bench": "pnpm --filter @frameout/web bench",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,css}\""
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "prettier": "3.9.10"
  }
}
