{
  "name": "frameout",
  "private": true,
  "version": "2.0.0",
  "main": "electron/main.cjs",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "backend/.venv/bin/python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload --reload-dir backend/app",
    "desktop": "npm run build && electron .",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:backend": "backend/.venv/bin/python -m pytest backend/tests -q"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.2.3"
  }
}
