{
  "name": "frameout",
  "private": true,
  "version": "2.0.0",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev:frontend": "pnpm --filter @frameout/frontend dev",
    "dev:server": "node --watch server/index.cjs",
    "desktop": "pnpm build && electron .",
    "build:desktop": "pnpm build && node scripts/build-desktop.mjs",
    "build": "pnpm --filter @frameout/frontend build",
    "typecheck": "pnpm --filter @frameout/frontend typecheck",
    "test": "pnpm --filter @frameout/frontend test",
    "test:desktop": "node --test electron/*.test.cjs utils/*.test.cjs",
    "test:server": "node --test server/*.test.cjs",
    "test:all": "pnpm test && pnpm test:desktop && pnpm test:server",
    "bench": "pnpm --filter @frameout/frontend bench"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.2.3"
  }
}
